# AJMFit Environment Variables
# Copy this file to .env.local and fill in values

# Beehiiv Newsletter Integration
# Get from: beehiiv dashboard → Settings → Integrations → API Keys
BEEHIIV_API_KEY=
# Get from: beehiiv dashboard → Settings → Publication ID
BEEHIIV_PUBLICATION_ID=

# Zoom Server-to-Server OAuth (marketplace.zoom.us → your app → App Credentials)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token (Feature tab) — for validating Zoom webhooks
ZOOM_SECRET_TOKEN=

# Transactional email (Hostinger SMTP). Used for session booking confirmations.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AJM Fit <anthony@ajmfit.com>

# Calendly (single account: anthony@ajmfit.com)
# Personal access token: Calendly → Integrations & apps → API & webhooks → Personal access tokens
CALENDLY_API_TOKEN=
# Shared secret appended to the webhook callback URL (?token=...) — this plan has no signing keys.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CALENDLY_WEBHOOK_TOKEN=
# Only if a higher Calendly plan issues one — HMAC verification then takes over.
CALENDLY_WEBHOOK_SIGNING_KEY=
