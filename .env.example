# AJM FIT — required environment variables (copy to .env.local and fill in).
# NO real values here. Get secrets from Shane via password-manager share, or
# from the service dashboards listed. Production runtime values live in
# Vercel project env (Settings -> Environment Variables), so the app deploys
# without this file; you need it only for local scripts/dev.

# --- Supabase (project ref xsmxenpynyusmiihtuex, account shane@atlasmindsco.com) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://xsmxenpynyusmiihtuex.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase dashboard -> Settings -> API
SUPABASE_SERVICE_ROLE_KEY=           # same page; SERVER-ONLY, never expose
DATABASE_URL=                        # Session pooler string; only for scripts/migrate.mjs

# --- Stripe (LIVE, Anthony's account) ---
STRIPE_SECRET_KEY=                   # Stripe dashboard -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=               # webhook endpoint we_... -> signing secret

# --- Email (Hostinger SMTP, anthony@ajmfit.com mailbox) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=anthony@ajmfit.com
SMTP_PASS=                           # the MAILBOX password (not the DB password)
SMTP_FROM=AJM Fit <anthony@ajmfit.com>

# --- Kit / newsletter (account anthony@ajmfit.com) ---
KIT_API_KEY=                         # Kit -> Settings -> Developer
KIT_WELCOME_SEQUENCE_ID=2800010      # optional; code defaults to these
KIT_BG_TAG_ID=20490383

# --- Zoom (Server-to-Server OAuth app "AJM Fit Scheduling") ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=

# --- Scheduling (Calendly being replaced by Cal.com) ---
CALENDLY_API_TOKEN=                  # PAT; scripts only, not needed in prod runtime
CALENDLY_WEBHOOK_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=        # empty on current plan; leave blank
CALCOM_API_KEY=                      # for the Cal.com migration
# NEXT_PUBLIC_CALENDLY_URL=          # optional override for the booking embed

# --- Misc APIs ---
OPENAI_API_KEY=                      # Chea chatbot (gpt-4o-mini)
USDA_API_KEY=                        # food lookup
HOSTINGER_API_KEY=                   # DNS management scripts only

# --- Seed/test helpers (scripts only, optional) ---
# TRAINER_EMAIL=
# TRAINER_PASSWORD=
